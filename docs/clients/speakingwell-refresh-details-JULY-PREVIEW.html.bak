<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Speaking Well of God — Website Refresh, Detailed Summary</title>
<style>
	@page { size: letter; margin: 0.9in 0.85in; }
	* { box-sizing: border-box; margin: 0; padding: 0; }
	:root {
		--ink: #16283C; --deep: #0E2A47; --primary: #2E6DA8;
		--soft: #E9F1F8; --gold: #C89B3C; --muted: #5A6B7E;
	}
	body { font: 10.5pt/1.55 -apple-system, "Helvetica Neue", Arial, sans-serif; color: var(--ink); }
	.serif { font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif; }

	/* ---- cover ---- */
	.cover { page-break-after: always; }
	.cover__eyebrow { color: var(--gold); font-weight: 700; letter-spacing: .22em; font-size: 8.5pt; text-transform: uppercase; margin-bottom: 10pt; }
	.cover__panel { background: linear-gradient(160deg, #0B1F35 0%, var(--deep) 55%, #1B4B79 100%); color: #fff; padding: 34pt 30pt 0; border-radius: 2pt; min-height: 620pt; display: flex; flex-direction: column; }
	.cover__title { font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif; font-size: 33pt; line-height: 1.12; font-weight: 700; margin-bottom: 12pt; }
	.cover__sub { font-size: 12.5pt; color: #DCE7F2; max-width: 34em; }
	.cover__spacer { flex: 1; }
	.cover__foot { border-top: 1px solid rgba(255,255,255,.25); margin: 0 -30pt; padding: 14pt 30pt 26pt; font-size: 9.5pt; color: #C4D3E2; }
	.cover__foot b { color: #fff; }

	/* ---- sections ---- */
	h2 { font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif; color: var(--deep); font-size: 16pt; font-weight: 700; border-bottom: 1.5pt solid var(--gold); padding-bottom: 4pt; margin: 22pt 0 10pt; break-after: avoid; }
	h3 { color: var(--primary); font-size: 9.5pt; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; margin: 13pt 0 5pt; break-after: avoid; }
	p { margin: 0 0 7pt; }
	ul { margin: 0 0 8pt 14pt; }
	li { margin-bottom: 3.5pt; }
	.lead { color: var(--muted); }
	code { background: var(--soft); border-radius: 3pt; padding: 0 3pt; font-size: 9pt; font-family: Menlo, Consolas, monospace; }
	.callout { background: var(--soft); border-left: 3pt solid var(--gold); border-radius: 3pt; padding: 8pt 11pt; margin: 9pt 0; break-inside: avoid; }
	.cols { display: flex; gap: 22pt; margin: 10pt 0 4pt; }
	.cols > div { flex: 1; }
